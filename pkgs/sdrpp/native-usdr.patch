@@ -0,0 +1,18 @@
+cmake_minimum_required(VERSION 3.13)
+project(usdr_source_tests LANGUAGES CXX)
+set(CMAKE_CXX_STANDARD 17)
+find_package(PkgConfig REQUIRED)
+pkg_check_modules(VOLK REQUIRED IMPORTED_TARGET volk)
+# A local header path permits offline tests without installing libusdr.
+if(USDR_SOURCE_DIR)
+    get_filename_component(USDR_SOURCE_DIR "${USDR_SOURCE_DIR}" ABSOLUTE BASE_DIR "${CMAKE_BINARY_DIR}")
+    set(USDR_TEST_INCLUDES "${USDR_SOURCE_DIR}/src/lib/models" "${USDR_SOURCE_DIR}/src/lib/port")
+else()
+    pkg_check_modules(USDR REQUIRED usdr)
+    set(USDR_TEST_INCLUDES ${USDR_INCLUDE_DIRS})
+endif()
+enable_testing()
+add_executable(usdr_receiver_test receiver_test.cpp ../src/receiver.cpp)
+target_include_directories(usdr_receiver_test PRIVATE ${USDR_TEST_INCLUDES} "${CMAKE_CURRENT_SOURCE_DIR}/../../../core/src")
+target_link_libraries(usdr_receiver_test PRIVATE PkgConfig::VOLK)
+add_test(NAME usdr_dma_ownership COMMAND usdr_receiver_test)
diff --git a/source_modules/usdr_source/tests/receiver_test.cpp b/source_modules/usdr_source/tests/receiver_test.cpp
new file mode 100644
index 00000000..74834081
--- /dev/null
+++ b/source_modules/usdr_source/tests/receiver_test.cpp
@@ -0,0 +1,164 @@
+#include "../src/receiver.h"
+#include <array>
+#include <iostream>
+#include <map>
+#include <stdexcept>
+#include <vector>
+#include <functional>
+#include <thread>
+#include <atomic>
+#include <chrono>
+#include <dsp/stream.h>
+using native_usdr::Receiver;
+using native_usdr::Settings;
+static void require(bool test) { if (!test) throw std::runtime_error("test assertion failed"); }
+namespace {
+std::map<std::string, uint64_t> values;
+std::string path;
+bool opened = false, created = false, started = false, borrowed = false;
+int acquireError = 0, releaseFailures = 0, startError = 0;
+std::string failSet;
+unsigned invalidBlock = 0, releases = 0, closes = 0, acquireDelay = 0;
+uint64_t timestamp = 0, lost = 0;
+std::atomic<bool> acquiring{false}, holdAcquire{false};
+std::array<int16_t, 8> samples = {-32768, 32767, -16384, 16384, 0, 16, -16, 0};
+void reset() {
+    require(!opened && !created && !started && !borrowed);
+    values.clear(); path.clear(); acquireError = releaseFailures = startError = 0;
+    failSet.clear(); invalidBlock = releases = closes = acquireDelay = 0; timestamp = lost = 0;
+}
+void throws(const std::function<void()>& op) { bool caught = false; try { op(); } catch (const std::runtime_error&) { caught = true; } require(caught); }
+}
+extern "C" {
+int usdr_dmd_create_string(const char* connection, pdm_dev_t* out) {
+    require(std::string(connection) == "bus=pcie,dev=usdr0" && !opened);
+    opened = true; *out = reinterpret_cast<pdm_dev_t>(1); return 0;
+}
+int usdr_dmd_close(pdm_dev_t) {
+    // Simulate final fd shutdown even if a removed device rejects release.
+    opened = created = started = borrowed = false; ++closes; return 0;
+}
+int usdr_dme_set_uint(pdm_dev_t, const char* name, uint64_t value) {
+    require(opened && !borrowed);
+    if (name == failSet) return -EIO;
+    values[name] = value;
+    return 0;
+}
+int usdr_dme_get_uint(pdm_dev_t, const char* name, uint64_t* out) {
+    require(opened && !borrowed);
+    *out = values.at(name);
+    // Applied gain and sample rate intentionally differ from the request.
+    if (std::string(name) == "/dm/sdr/0/rx/gain/auto" && *out) --*out;
+    if (std::string(name) == "/dm/rate/master") *out -= 10;
+    return 0;
+}
+int usdr_dme_set_string(pdm_dev_t, const char*, const char* value) { require(!borrowed); path = value; return 0; }
+int usdr_dme_get_string(pdm_dev_t, const char*, const char** out) { *out = path.c_str(); return 0; }
+int usdr_dms_create(pdm_dev_t, const char* name, const char* format, logical_ch_msk_t channels, unsigned count, pusdr_dms_t* out) {
+    require(std::string(name) == "/ll/srx/0" && std::string(format) == "ci16" && channels == 1 && count == 16384);
+    require(opened && !created); created = true; *out = reinterpret_cast<pusdr_dms_t>(2); return 0;
+}
+int usdr_dms_sync(pdm_dev_t, const char*, unsigned, pusdr_dms_t*) { require(created && !borrowed); return 0; }
+int usdr_dms_op(pusdr_dms_t, unsigned op, dm_time_t) {
+    require(created && !borrowed);
+    if (op == USDR_DMS_START) { started = true; return startError; }
+    require(op == USDR_DMS_STOP); started = false; return 0;
+}
+int usdr_dms_destroy(pusdr_dms_t) { require(created && !borrowed && !started); created = false; return 0; }
+int usdr_dms_acquire(pusdr_dms_t, unsigned timeout, usdr_dms_rx_block_t* out) {
+    require(created && started && !borrowed && timeout == 100);
+    acquiring = true;
+    while (holdAcquire) std::this_thread::yield();
+    if (acquireDelay) std::this_thread::sleep_for(std::chrono::milliseconds(acquireDelay));
+    if (acquireError) return acquireError;
+    borrowed = true;
+    *out = {samples.data(), sizeof(samples), 4, USDR_DMS_NATIVE_CI16_LE, timestamp, lost, 123, 0};
+    if (invalidBlock == 1) out->bytes++;
+    if (invalidBlock == 2) out->format = 99;
+    if (invalidBlock == 3) out->data = nullptr;
+    if (invalidBlock == 4) out->samples = 0;
+    timestamp += 4; return 0;
+}
+int usdr_dms_release(pusdr_dms_t, const usdr_dms_rx_block_t* block) {
+    require(borrowed && block->token == 123);
+    if (releaseFailures) { --releaseFailures; return -EIO; }
+    borrowed = false; ++releases; return 0;
+}
+}
+int main() {
+    try {
+        std::array<float, 8> out{};
+        reset();
+        {
+            Receiver rx; rx.open({});
+            require(rx.status().rate == 7999990 && rx.status().gain == 29 && rx.status().path == "EXT");
+            rx.start();
+            require(rx.read(out.data(), 4) == 4 && releases == 1 && !borrowed);
+            for (size_t i = 0; i < out.size(); ++i) require(out[i] == samples[i] / 32768.0f);
+            // Reusing DMA storage cannot alter the already converted output.
+            auto expected = out; auto saved = samples; samples.fill(1234); require(out == expected); samples = saved;
+            timestamp += 8; lost = 8; rx.read(out.data(), 4);
+            require(rx.status().samples == 8 && rx.status().lost == 8 && rx.status().discontinuities == 1);
+            acquireError = -ETIMEDOUT; require(rx.read(out.data(), 4) == 0 && rx.status().timeouts == 1);
+            acquireError = -EIO; throws([&] { rx.read(out.data(), 4); }); acquireError = 0;
+            rx.tune(600000000); rx.setGain(40);
+            require(rx.status().frequency == 600000000 && rx.status().gain == 39);
+            rx.close(); rx.close(); require(closes == 1);
+            rx.open({}); rx.start(); rx.read(out.data(), 4); require(rx.status().samples == 4); rx.close();
+        }
+        for (unsigned bad = 1; bad <= 5; ++bad) {
+            reset(); Receiver rx; rx.open({}); rx.start(); invalidBlock = bad;
+            throws([&] { rx.read(out.data(), bad == 5 ? 3 : 4); });
+            require(!borrowed && releases == 1); rx.close();
+        }
+        reset(); { Receiver rx; failSet = "/dm/sdr/0/rx/bandwidth"; throws([&] { rx.open({}); }); require(!opened && closes == 1); }
+        reset(); { Receiver rx; rx.open({}); startError = -EIO; throws([&] { rx.start(); }); require(!opened && !started); }
+        reset(); { Receiver rx; rx.open({}); rx.start(); releaseFailures = 1; throws([&] { rx.read(out.data(), 4); }); require(borrowed); require(rx.close() == 0 && !borrowed); }
+        reset(); { Receiver rx; rx.open({}); rx.start(); releaseFailures = 2; throws([&] { rx.read(out.data(), 4); }); require(rx.close() < 0 && !opened); }
+        reset(); { Receiver rx; Settings s; s.device = "usdr0,bus=usb"; throws([&] { rx.open(s); }); require(!opened); }
+        reset(); {
+            Receiver rx; rx.open({}); rx.start(); acquireDelay = 10;
+            std::thread reader([&] { for (int i = 0; i < 10; ++i) rx.read(out.data(), 4); });
+            for (int i = 0; i < 10; ++i) { rx.tune(202000000 + i); rx.setGain(i); }
+            reader.join(); rx.close();
+        }
+        reset(); {
+            Receiver rx; rx.open({}); rx.start();
+            acquiring = false; holdAcquire = true;
+            std::thread reader([&] { rx.read(out.data(), 4); });
+            while (!acquiring) std::this_thread::yield();
+            std::atomic<bool> statusReturned{false};
+            std::thread display([&] { rx.status(); statusReturned = true; });
+            const auto deadline = std::chrono::steady_clock::now() + std::chrono::milliseconds(250);
+            while (!statusReturned && std::chrono::steady_clock::now() < deadline) std::this_thread::yield();
+            const bool independent = statusReturned;
+            holdAcquire = false; reader.join(); display.join(); rx.close();
+            require(independent);
+        }
+        reset(); {
+            Receiver rx; rx.open({}); rx.start();
+            dsp::stream<float> output;
+            std::atomic<unsigned> converted{0};
+            std::thread producer([&] {
+                for (int i = 0; i < 3; ++i) {
+                    const unsigned n = rx.read(output.writeBuf, 4);
+                    ++converted;
+                    if (!output.swap(n * 2)) break;
+                }
+                rx.close();
+            });
+            // Deliberately never consume the first buffer. The second swap blocks,
+            // but its native DMA lease must already have been returned.
+            const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(2);
+            while (converted.load() < 2 && std::chrono::steady_clock::now() < deadline)
+                std::this_thread::yield();
+            const bool returned = converted.load() == 2 && !borrowed && releases == 2;
+            const auto before = std::chrono::steady_clock::now();
+            output.stopWriter(); producer.join();
+            require(returned && !opened && std::chrono::steady_clock::now() - before < std::chrono::seconds(1));
+        }
+        reset();
+        std::cout << "PASS: conversion, applied settings, DMA ownership, discontinuities, timeout, failure cleanup, restart, concurrent controls, nonblocking display status, blocked-consumer stop\n";
+        return 0;
+    } catch (const std::exception& e) { std::cerr << e.what() << '\n'; return 1; }
+}
