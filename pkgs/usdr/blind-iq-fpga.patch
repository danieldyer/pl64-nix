diff --git a/hw/usdr/build.tcl b/hw/usdr/build.tcl
index 27ed0fe..e6465a8 100644
--- a/hw/usdr/build.tcl
+++ b/hw/usdr/build.tcl
@@ -56,6 +56,20 @@ wait_on_run impl_1
 if {[get_property PROGRESS [get_runs impl_1]] ne "100%"} {error "Implementation failed"}
 open_run impl_1
 phys_opt_design -directive AggressiveExplore
+# Routing can leave a few picoseconds on a high-fanout FIR clock-enable path.
+# Refine the routed checkpoint rather than weakening clocks or emitting a
+# failing image. The ordinary setup/hold/skew guards below remain mandatory.
+for {set refinement 0} {$refinement < 3} {incr refinement} {
+    set setup [get_timing_paths -delay_type max -max_paths 1]
+    set hold [get_timing_paths -delay_type min -max_paths 1]
+    if {![llength $setup] || ![llength $hold]} {error "Missing timing paths"}
+    if {[get_property SLACK $setup] >= 0 && [get_property SLACK $hold] >= 0} {break}
+    phys_opt_design -directive AggressiveExplore
+    set setup [get_timing_paths -delay_type max -max_paths 1]
+    set hold [get_timing_paths -delay_type min -max_paths 1]
+    if {[get_property SLACK $setup] >= 0 && [get_property SLACK $hold] >= 0} {break}
+    route_design -directive Explore
+}
 report_timing_summary -delay_type min_max -report_unconstrained -file "$output/timing.rpt"
 set skew_report [report_bus_skew -return_string -file "$output/bus_skew.rpt"]
 report_cdc -details -file "$output/cdc.rpt"
diff --git a/lib/dsp/usdr_blind_iq.v b/lib/dsp/usdr_blind_iq.v
new file mode 100644
index 0000000..1e97cdd
--- /dev/null
+++ b/lib/dsp/usdr_blind_iq.v
@@ -0,0 +1,211 @@
+// SPDX-License-Identifier: CERN-OHL-P
+// Autonomous blind DC/IQ correction controller. The solver is sequential: one
+// shared pipelined 24x24 multiplier, restoring square root and restoring divider. No CPU
+// solver, sample buffering, division operator, or continuously running servo.
+module usdr_blind_iq #(parameter WINDOW_BITS=20)(
+ input clk,rst,input [31:0] cmd,input cmd_valid,
+ input [31:0] in_data,input in_valid,
+ output reg enabled,output reg signed[15:0] dc_i,dc_q,
+ output reg signed[23:0] ci,cq,cqi,output reg[31:0] result
+);
+localparam SW=12+WINDOW_BITS+1, MW=24+WINDOW_BITS+1;
+reg restart,frozen;reg[31:0] generation,seen,rejected;
+reg[63:0] tick,applied_tick;reg[31:0] raw_clips;
+reg[11:0] peak,peak_result;reg[31:0] power_i,power_q;
+wire raw_clip=in_data[15:4]==12'h800 || in_data[15:4]==12'h7ff ||
+              in_data[31:20]==12'h800 || in_data[31:20]==12'h7ff;
+wire[11:0] mag_i=in_data[15] ? -in_data[15:4] : in_data[15:4];
+wire[11:0] mag_q=in_data[31] ? -in_data[31:20] : in_data[31:20];
+wire[31:0] stats_gen;wire signed[SW-1:0] si,sq;
+wire[MW-1:0] sii,sqq;wire signed[MW-1:0] siq;wire[WINDOW_BITS:0] clips;
+usdr_iq_stats #(.WINDOW_BITS(WINDOW_BITS)) stats(clk,rst||restart,1'b1,
+ $signed(in_data[15:4]),$signed(in_data[31:20]),in_valid,
+ stats_gen,si,sq,sii,sqq,siq,clips);
+reg[5:0] state;
+reg signed[23:0] mi,mq,mx,my;
+// Explicit single-DSP partial products keep every multiplier stage short at
+// the core's 200 MHz timing constraint. Reuse this one pipelined unit for the
+// covariance, determinant and coefficient calculations.
+(* use_dsp = "yes" *) reg[23:0] mul_ll;
+(* use_dsp = "yes" *) reg signed[23:0] mul_hh;
+(* use_dsp = "yes" *) reg signed[24:0] mul_hl,mul_lh;
+reg signed[47:0] mul_high_low,product;
+reg signed[25:0] mul_middle;
+always @(posedge clk) begin
+ mul_ll <= $unsigned(mx[11:0]) * $unsigned(my[11:0]);
+ mul_hh <= $signed(mx[23:12]) * $signed(my[23:12]);
+ mul_hl <= $signed(mx[23:12]) * $signed({1'b0,my[11:0]});
+ mul_lh <= $signed({1'b0,mx[11:0]}) * $signed(my[23:12]);
+ mul_high_low <= {mul_hh,mul_ll};
+ mul_middle <= $signed(mul_hl) + $signed(mul_lh);
+ product <= mul_high_low + ($signed({{22{mul_middle[25]}},mul_middle}) <<< 12);
+end
+reg[5:0] multiply_return;
+reg signed[49:0] vi,vq,cross;
+reg signed[23:0] a,b,c;
+reg signed[47:0] ab,determinant,determinant_min;
+reg determinant_good;
+reg[47:0] rad;
+reg[25:0] rem;
+reg[23:0] root;
+wire[27:0] sqrt_rem={rem,rad[47:46]};
+wire[27:0] sqrt_trial=({4'b0,root}<<2)|1;
+wire[23:0] sqrt_next=(root<<1)|(sqrt_rem>=sqrt_trial);
+reg[5:0] count;
+reg[24:0] denominator;
+reg[47:0] numerator,quotient;
+reg[25:0] div_rem;
+wire[25:0] div_next={div_rem[24:0],numerator[47]};
+wire div_take=div_next>={1'b0,denominator};
+wire[47:0] quotient_next={quotient[46:0],div_take};
+reg[1:0] axis;
+reg signed[23:0] scale,pending_i,pending_q,pending_qi;
+reg signed[15:0] pending_di,pending_dq;
+reg[23:0] abs_cross;
+reg[15:0] abs_dc_i,abs_dc_q,max_dc_native,dc_headroom;
+reg[24:0] row_sum;
+always @(posedge clk) begin
+ abs_dc_i <= pending_di[15] ? -pending_di : pending_di;
+ abs_dc_q <= pending_dq[15] ? -pending_dq : pending_dq;
+ max_dc_native <= abs_dc_i > abs_dc_q ? abs_dc_i : abs_dc_q;
+ dc_headroom <= 16'd32768 - max_dc_native;
+ abs_cross <= c[23] ? -c : c;
+ row_sum <= {1'b0,a} + {1'b0,abs_cross};
+end
+wire signed[49:0] raw_i=$signed({1'b0,sii}) << (24-WINDOW_BITS);
+wire signed[49:0] raw_q=$signed({1'b0,sqq}) << (24-WINDOW_BITS);
+wire signed[49:0] raw_cross=$signed(siq) << (24-WINDOW_BITS);
+// Bank 7: every result belongs to the latest coefficient generation. Readers
+// check generation before/after a multiword snapshot and retry on change.
+always @* begin
+ result=0;
+ case(cmd[23:16])
+  0:result=32'h49514331; // IQC1
+  1:result={30'b0,frozen,enabled};
+  2:result=generation;
+  3:result={{8{ci[23]}},ci};4:result={{8{cq[23]}},cq};5:result={{8{cqi[23]}},cqi};
+  6:result={{16{dc_i[15]}},dc_i};7:result={{16{dc_q[15]}},dc_q};
+  8:result=raw_clips;9:result=applied_tick[31:0];10:result=applied_tick[63:32];
+  15:result=seen;
+  11:result=rejected;12:result=power_i;13:result=power_q;14:result={16'b0,peak_result,4'b0};
+ endcase
+end
+always @(posedge clk) begin
+ restart<=0;
+ if(rst) begin
+  enabled<=1;frozen<=0;restart<=0;generation<=0;seen<=0;rejected<=0;
+  dc_i<=0;dc_q<=0;ci<=24'h7fffff;cq<=24'h7fffff;cqi<=0;
+  state<=0;tick<=0;applied_tick<=0;raw_clips<=0;peak<=0;peak_result<=0;
+  power_i<=0;power_q<=0;mx<=0;my<=0;
+ end else begin
+  if(in_valid)begin
+   tick<=tick+1'b1;
+   if(raw_clip)raw_clips<=raw_clips+1'b1;
+   if(mag_i>peak)peak<=mag_i;
+   if(mag_q>peak && mag_q>=mag_i)peak<=mag_q;
+  end
+  if(restart)begin state<=0;seen<=0;end else case(state)
+   0:if(stats_gen!=seen)begin
+    seen<=stats_gen;peak_result<=peak;peak<=0;
+    power_i<=sii>>WINDOW_BITS;power_q<=sqq>>WINDOW_BITS;
+    if(enabled && !frozen && !clips)begin
+     mi<=si >>> (WINDOW_BITS-12);mq<=sq >>> (WINDOW_BITS-12);
+     state<=1;
+    end else if(clips)rejected<=rejected+1'b1;
+   end
+   1:begin
+    pending_di<=mi >>> 8;pending_dq<=mq >>> 8;
+    pending_i<=ci;pending_q<=cq;pending_qi<=cqi;
+    mx<=mi;my<=mi;state<=16;
+   end
+   2:begin vi<=raw_i-$signed(product);mx<=mq;my<=mq;state<=17;end
+   3:begin vq<=raw_q-$signed(product);mx<=mi;my<=mq;state<=18;end
+   4:begin cross<=raw_cross-$signed(product);state<=5;end
+   5:begin
+    if(vi<(50'sd16<<24) || vq<(50'sd16<<24))begin
+     rejected<=rejected+1'b1;state<=40;
+    end else state<=15;
+   end
+   15:begin
+    if(vi[49:23]!=0 || vq[49:23]!=0)begin
+     vi<=vi>>>1;vq<=vq>>>1;cross<=cross>>>1;
+    end else begin a<=vi[23:0];b<=vq[23:0];c<=cross[23:0];state<=6;end
+   end
+   6:begin
+    if((a>>>4)>b || (b>>>4)>a)begin rejected<=rejected+1'b1;state<=40;end
+    else begin mx<=a;my<=b;state<=19;end
+   end
+   7:begin ab<=product;mx<=c;my<=c;state<=20;end
+   8:begin determinant<=ab-product;determinant_min<=ab>>>6;state<=25;end
+   25:begin determinant_good<=determinant>0 && determinant>=determinant_min;state<=26;end
+   26:begin
+    if(!determinant_good)begin rejected<=rejected+1'b1;state<=40;end
+    else begin rad<=determinant;rem<=0;root<=0;count<=0;state<=9;end
+   end
+   9:begin
+    rem<=sqrt_rem>=sqrt_trial?sqrt_rem-sqrt_trial:sqrt_rem;
+    root<=sqrt_next;rad<=rad<<2;
+    if(count==23)state<=10;else count<=count+1'b1;
+   end
+   10:begin
+    if(root==0)begin rejected<=rejected+1'b1;state<=40;end
+    else begin
+     denominator<=row_sum>{1'b0,root}?row_sum:{1'b0,root};
+     // 10% guard plus DC-dependent bound: (1-d)(1+d)<=1.
+     mx<=24'd7549747;my<={8'b0,dc_headroom};state<=21;
+    end
+   end
+   11:begin scale<=product>>>15;axis<=0;state<=12;end
+   12:begin mx<=scale;my<=axis==0?root:axis==1?a:abs_cross;state<=22;end
+   13:begin numerator<=product;quotient<=0;div_rem<=0;count<=0;state<=14;end
+   14:begin
+    div_rem<=div_take?div_next-denominator:div_next;
+    numerator<=numerator<<1;quotient<=quotient_next;
+    if(count==47)begin
+     if(quotient_next>48'h7fffff)begin rejected<=rejected+1'b1;state<=0;end
+     else begin
+      if(axis==0)pending_i<=quotient_next[23:0];
+      if(axis==1)pending_q<=quotient_next[23:0];
+      if(axis==2)pending_qi<=c[23]?quotient_next[23:0]:-$signed(quotient_next[23:0]);
+      if(axis==2)state<=40;else begin axis<=axis+1'b1;state<=12;end
+     end
+    end else count<=count+1'b1;
+   end
+   16:begin multiply_return<=2;state<=23;end
+   17:begin multiply_return<=3;state<=23;end
+   18:begin multiply_return<=4;state<=23;end
+   19:begin multiply_return<=7;state<=23;end
+   20:begin multiply_return<=8;state<=23;end
+   21:begin multiply_return<=11;state<=23;end
+   22:begin multiply_return<=13;state<=23;end
+   23:state<=24;
+   24:state<=multiply_return;
+   40:begin
+    // Offsets and coefficients become visible together on an IQ-pair boundary.
+    if(in_valid)begin
+     if(enabled && !frozen)begin
+      dc_i<=pending_di;dc_q<=pending_dq;ci<=pending_i;cq<=pending_q;cqi<=pending_qi;
+      generation<=generation+1'b1;applied_tick<=tick+1'b1;
+     end
+     state<=0;
+    end
+   end
+   default:state<=0;
+  endcase
+  // Legacy manual coefficient commits select manual mode. The matched driver
+  // explicitly reenables autonomous correction after startup calibration.
+  if(cmd_valid && !cmd[31] && cmd[30:24]==5)begin
+   enabled<=0;generation<=generation+1'b1;applied_tick<=tick+(in_valid?1'b1:1'b0);
+  end
+  if(cmd_valid && !cmd[31] && cmd[30:24]==7 && cmd[23:16]==1)begin
+   enabled<=cmd[0];frozen<=cmd[1];
+   generation<=generation+1'b1;applied_tick<=tick+(in_valid?1'b1:1'b0);
+   if(cmd[2])begin
+    restart<=1;seen<=0;state<=0;dc_i<=0;dc_q<=0;
+    ci<=24'h7fffff;cq<=24'h7fffff;cqi<=0;
+    generation<=generation+1'b1;applied_tick<=tick+(in_valid?1'b1:1'b0);
+   end
+  end
+ end
+end
+endmodule
