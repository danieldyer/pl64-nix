diff --git a/tests/usdr_blind_iq_test.v b/tests/usdr_blind_iq_test.v
new file mode 100644
index 0000000..babd9f1
--- /dev/null
+++ b/tests/usdr_blind_iq_test.v
@@ -0,0 +1,53 @@
+`timescale 1ns/1ps
+module usdr_blind_iq_test;
+reg clk=0;always #5 clk=~clk;
+reg rst=1,valid=0,cv=0;reg[31:0] data=0,cmd=0;
+wire en;wire signed[15:0] di,dq;wire signed[23:0] ci,cq,cqi;wire[31:0] result;
+usdr_blind_iq #(.WINDOW_BITS(12)) dut(clk,rst,cmd,cv,data,valid,en,di,dq,ci,cq,cqi,result);
+integer k,ii,qq,ri,rq;reg running=1,inject_clip=0;
+always @(negedge clk)begin
+ if(rst || !running)valid=0;
+ else begin
+  valid=~valid;
+  if(valid)begin
+   ii=(k&1)?512:-512;qq=(k&2)?512:-512;
+   ri=ii+23;rq=(3*qq+ii)/4-17;
+   data={(rq[11:0]),4'b0,(ri[11:0]),4'b0};
+   if(inject_clip)data[15:4]=12'h800;
+   k=k+1;
+  end
+ end
+end
+task write;input[31:0] word;begin @(posedge clk);#1;cmd=word;cv=1;@(posedge clk);#1;cv=0;end endtask
+function integer absolute;input integer x;begin absolute=x<0?-x:x;end endfunction
+reg signed[23:0] saved;reg[31:0] gen;
+initial begin
+ k=0;repeat(10)@(posedge clk);#1;rst=0;
+ wait(dut.generation>=3);@(negedge clk);
+ if(di!==368 || dq!==-272)$fatal(1,"means %d %d",di,dq);
+ if(absolute(ci-4478976)>32 || absolute(cq-5971968)>32 || absolute(cqi+1492992)>32)
+  $fatal(1,"coefficients %d %d %d",ci,cq,cqi);
+ // The matrix transforms the entire known signal, not just covariance.
+ for(k=0;k<4;k=k+1)begin
+  ii=(k&1)?512:-512;qq=(k&2)?512:-512;
+  ri=ii+23;rq=(3*qq+ii)/4-17;
+  if(absolute((($signed(cq)*(rq*16-dq)+$signed(cqi)*(ri*16-di))>>>23)-
+              (($signed(ci)*(qq*16))>>>23))>1)$fatal(1,"complex waveform error");
+ end
+ saved=ci;write(32'h07010003);gen=dut.generation;
+ repeat(20000)@(posedge clk);
+ if(ci!==saved || dut.generation!==gen)$fatal(1,"freeze changed correction");
+ write(32'h07010001);inject_clip=1;
+ // Let the window containing the control transition complete, then every
+ // subsequent clipped window must be rejected without updating coefficients.
+ repeat(20000)@(posedge clk);gen=dut.generation;
+ repeat(20000)@(posedge clk);
+ if(dut.generation!==gen || !dut.rejected)$fatal(1,"clipped window accepted");
+ inject_clip=0;write(32'h07010005);
+ wait(dut.generation>gen+1);
+ write(32'h05000000);if(en)$fatal(1,"manual commit did not override auto");
+ write(32'h07010001);if(!en)$fatal(1,"auto enable failed");
+ $display("PASS autonomous fixed-point DC/IQ solver, waveform correction, freeze, clipping rejection, reset and manual override");$finish;
+end
+initial begin #5000000;$fatal(1,"watchdog state=%d gen=%d rejected=%d",dut.state,dut.generation,dut.rejected);end
+endmodule
diff --git a/tests/usdr_blind_iq_vectors_test.v b/tests/usdr_blind_iq_vectors_test.v
new file mode 100644
index 0000000..408b3a7
--- /dev/null
+++ b/tests/usdr_blind_iq_vectors_test.v
@@ -0,0 +1,29 @@
+`timescale 1ns/1ps
+module usdr_blind_iq_vectors_test;
+reg clk=0;always #5 clk=~clk;
+reg rst=1,valid=0;reg[31:0]data=0;wire en;wire signed[15:0]di,dq;wire signed[23:0]ci,cq,cqi;wire[31:0]result;
+usdr_blind_iq #(.WINDOW_BITS(16)) dut(clk,rst,32'b0,1'b0,data,valid,en,di,dq,ci,cq,cqi,result);
+integer scenario,n,ig,qg,cross_gain,off_i,off_q,ei,eq,ec,ii,qq,ri,rq;
+function integer abs;input integer x;begin abs=x<0?-x:x;end endfunction
+initial begin
+for(scenario=0;scenario<5;scenario=scenario+1)begin
+case(scenario)
+0:begin ig=8;qg=6;cross_gain=2;off_i=23;off_q=-17;ei=4478976;eq=5971968;ec=-1492992;end
+1:begin ig=6;qg=10;cross_gain=-1;off_i=-173;off_q=61;ei=6912000;eq=4147200;ec=691200;end
+2:begin ig=10;qg=6;cross_gain=-4;off_i=-400;off_q=-250;ei=2603652;eq=4339419;ec=1735768;end
+3:begin ig=8;qg=10;cross_gain=0;off_i=0;off_q=0;ei=7549747;eq=6039798;ec=0;end
+4:begin ig=8;qg=8;cross_gain=0;off_i=0;off_q=0;ei=7549747;eq=7549747;ec=0;end
+endcase
+rst=1;valid=0;repeat(4)@(negedge clk);rst=0;
+for(n=0;n<70000;n=n+1)begin
+ ii=(n&1)?512:-512;qq=(n&2)?512:-512;
+ ri=ig*ii/8+off_i;rq=qg*qq/8+cross_gain*ii/8+off_q;
+ @(negedge clk);data={rq[11:0],4'b0,ri[11:0],4'b0};valid=1;
+ @(negedge clk);valid=0;
+end
+if(!dut.generation || abs(ci-ei)>64 || abs(cq-eq)>64 || abs(cqi-ec)>64 || di!=off_i*16 || dq!=off_q*16)
+ $fatal(1,"case %d coeff %d %d %d expected %d %d %d offsets %d %d",scenario,ci,cq,cqi,ei,eq,ec,di,dq);
+end
+$display("PASS autonomous IQ vectors: positive/negative skew, gain asymmetry, large signed offsets and balanced input");$finish;
+end
+endmodule
