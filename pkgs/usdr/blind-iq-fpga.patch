diff --git a/lib/dsp/usdr_iq_stats.v b/lib/dsp/usdr_iq_stats.v
new file mode 100644
index 0000000..f856198
--- /dev/null
+++ b/lib/dsp/usdr_iq_stats.v
@@ -0,0 +1,51 @@
+// SPDX-License-Identifier: CERN-OHL-P
+// Full-rate raw moments, before digital DC/IQ correction.
+// Means/covariance are formed from these exact sums; never from corrected IQ.
+module usdr_iq_stats #(
+ parameter WIDTH=12, WINDOW_BITS=20,
+ parameter SUM_WIDTH=WIDTH+WINDOW_BITS+1,
+ parameter MOM_WIDTH=2*WIDTH+WINDOW_BITS+1
+)(
+ input clk, input rst, input enable,
+ input signed [WIDTH-1:0] in_i, in_q, input in_valid,
+ output reg [31:0] generation,
+ output reg signed [SUM_WIDTH-1:0] sum_i, sum_q,
+ output reg [MOM_WIDTH-1:0] sum_ii, sum_qq,
+ output reg signed [MOM_WIDTH-1:0] sum_iq,
+ output reg [WINDOW_BITS:0] clips
+);
+reg pv, pc;
+reg signed [WIDTH-1:0] pi,pq;
+reg signed [2*WIDTH-1:0] pii,pqq,piq;
+reg [WINDOW_BITS-1:0] count;
+reg signed [SUM_WIDTH-1:0] ai,aq;
+reg [MOM_WIDTH-1:0] aii,aqq;
+reg signed [MOM_WIDTH-1:0] aiq;
+reg [WINDOW_BITS:0] ac;
+wire signed [SUM_WIDTH-1:0] ni=ai+pi, nq=aq+pq;
+wire [MOM_WIDTH-1:0] nii=aii+$unsigned(pii), nqq=aqq+$unsigned(pqq);
+wire signed [MOM_WIDTH-1:0] niq=aiq+piq;
+wire [WINDOW_BITS:0] nc=ac+pc;
+always @(posedge clk) begin
+ if(rst) begin
+  generation<=0;sum_i<=0;sum_q<=0;sum_ii<=0;sum_qq<=0;sum_iq<=0;clips<=0;
+ end else if(enable && pv && (&count)) begin
+  generation<=generation+1'b1;sum_i<=ni;sum_q<=nq;sum_ii<=nii;sum_qq<=nqq;sum_iq<=niq;clips<=nc;
+ end
+ if(rst || !enable) begin
+  pv<=0;count<=0;ai<=0;aq<=0;aii<=0;aqq<=0;aiq<=0;ac<=0;
+ end else begin
+  pv<=in_valid;
+  if(in_valid) begin
+   pi<=in_i;pq<=in_q;pii<=in_i*in_i;pqq<=in_q*in_q;piq<=in_i*in_q;
+   pc<=(in_i=={1'b1,{(WIDTH-1){1'b0}}} || in_i=={1'b0,{(WIDTH-1){1'b1}}} ||
+        in_q=={1'b1,{(WIDTH-1){1'b0}}} || in_q=={1'b0,{(WIDTH-1){1'b1}}});
+  end
+  if(pv) begin
+   count<=count+1'b1;
+   if(&count) begin ai<=0;aq<=0;aii<=0;aqq<=0;aiq<=0;ac<=0;end
+   else begin ai<=ni;aq<=nq;aii<=nii;aqq<=nqq;aiq<=niq;ac<=nc;end
+  end
+ end
+end
+endmodule
