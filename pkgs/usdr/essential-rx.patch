diff --git a/audit/2026-10-22/native_rx_probe.c b/audit/2026-10-22/native_rx_probe.c
new file mode 100644
index 0000000..1f5b5f7
--- /dev/null
+++ b/audit/2026-10-22/native_rx_probe.c
@@ -0,0 +1,87 @@
+// SPDX-License-Identifier: MIT
+// Target-only PCIe receive probe: native loans, or exactly one CI16 memcpy.
+#include <dm_dev.h>
+#include <dm_stream.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+
+static double now(void)
+{
+    struct timespec t;clock_gettime(CLOCK_MONOTONIC,&t);
+    return t.tv_sec+t.tv_nsec*1e-9;
+}
+static int set(pdm_dev_t d,const char *path,uint64_t value)
+{
+    int r=usdr_dme_set_uint(d,path,value);
+    if(r)fprintf(stderr,"%s: %s\n",path,strerror(-r));
+    return r;
+}
+static void show(pdm_dev_t d,const char *path)
+{
+    uint64_t v=0;int r=usdr_dme_get_uint(d,path,&v);
+    if(r)fprintf(stderr,"%s: %s\n",path,strerror(-r));
+    else printf("%s=%llu\n",path,(unsigned long long)v);
+}
+int main(int argc,char **argv)
+{
+    const char *device="bus=pcie",*input="EXT";
+    unsigned rate=64000000,frequency=202000000,bandwidth=28000000,gain=30;
+    double seconds=10;int copy=0,c,res=0,started=0,loan=0;
+    while((c=getopt(argc,argv,"d:i:r:f:b:g:s:ch"))!=-1)switch(c){
+        case 'd':device=optarg;break;case 'i':input=optarg;break;
+        case 'r':rate=strtoul(optarg,NULL,0);break;case 'f':frequency=strtoul(optarg,NULL,0);break;
+        case 'b':bandwidth=strtoul(optarg,NULL,0);break;case 'g':gain=strtoul(optarg,NULL,0);break;
+        case 's':seconds=strtod(optarg,NULL);break;case 'c':copy=1;break;
+        default:fprintf(stderr,"%s [-d bus=pcie,dev=usdr0] [-i EXT|W|H|auto] [-r rate_Hz] [-f RF_Hz] [-b RF_BW_Hz] [-g relative_dB] [-s seconds] [-c one_copy]\n",argv[0]);return c=='h'?0:1;
+    }
+    if(!(seconds>0 && seconds<=3600) || rate<1000000 || rate>65000000 || !frequency || gain>85)return 1;
+    pdm_dev_t d=NULL;pusdr_dms_t s=NULL;usdr_dms_rx_block_t b={0};
+    void *scratch=copy?malloc(65536):NULL;
+    if(copy && !scratch)return 1;
+    // Indirect call prevents dead-store elimination in this standalone copy benchmark.
+    void *(*volatile copy_samples)(void*,const void*,size_t)=memcpy;
+    uint64_t blocks=0,samples=0,lost=0,expected=0,checksum=0;unsigned timeouts=0;
+    double begin=0,elapsed=0;
+    res=usdr_dmd_create_string(device,&d);if(res)goto done;
+    res=set(d,"/dm/power/en",1);if(res)goto done;
+    res=set(d,"/dm/rate/master",rate);if(res)goto done;
+    res=usdr_dme_set_string(d,"/dm/sdr/0/rx/path",input);if(res)goto done;
+    res=set(d,"/dm/sdr/0/rx/frequency",frequency);if(res)goto done;
+    res=set(d,"/dm/sdr/0/rx/bandwidth",bandwidth);if(res)goto done;
+    res=set(d,"/dm/sdr/0/rx/gain/auto",gain);if(res)goto done;
+    res=usdr_dms_create(d,"/ll/srx/0","ci16",1,16384,&s);if(res)goto done;
+    show(d,"/dm/rate/master");show(d,"/dm/rate/adc");show(d,"/dm/sdr/0/rx/frequency");
+    show(d,"/dm/sdr/0/rx/frequency/lob");show(d,"/dm/sdr/0/rx/bandwidth");
+    show(d,"/dm/sdr/0/rx/gain/auto");show(d,"/dm/sdr/0/rx/dccorr");
+    res=usdr_dms_sync(d,"off",1,&s);if(res)goto done;
+    started=1;res=usdr_dms_op(s,USDR_DMS_START,0);if(res)goto done;
+    res=usdr_dms_sync(d,"none",1,&s);if(res)goto done;
+    begin=now();
+    while(now()-begin<seconds){
+        res=usdr_dms_acquire(s,250,&b);
+        if(res==-ETIMEDOUT){++timeouts;res=0;continue;}
+        if(res)break;
+        loan=1;
+        if(b.format!=USDR_DMS_NATIVE_CI16_LE || b.bytes!=4ull*b.samples || b.bytes>65536){res=-EINVAL;break;}
+        if(blocks && b.timestamp!=expected+b.lost_samples){res=-EIO;break;}
+        if(copy){copy_samples(scratch,b.data,b.bytes);checksum^=((const uint32_t*)scratch)[b.samples/2];}
+        expected=b.timestamp+b.samples;lost+=b.lost_samples;samples+=b.samples;++blocks;
+        res=usdr_dms_release(s,&b);if(res)break;loan=0;
+    }
+    elapsed=now()-begin;
+    printf("mode=%s blocks=%llu samples=%llu lost=%llu timeouts=%u elapsed=%.6f rate=%.3f_MSps checksum=%llu\n",
+        copy?"one-copy":"borrow-only",(unsigned long long)blocks,(unsigned long long)samples,
+        (unsigned long long)lost,timeouts,elapsed,samples/elapsed/1e6,(unsigned long long)checksum);
+    if(!res && (!blocks || lost || timeouts))res=-EIO;
+done:
+    if(loan){int r=usdr_dms_release(s,&b);if(!res)res=r;}
+    if(started){int r=usdr_dms_op(s,USDR_DMS_STOP,0);if(!res)res=r;}
+    if(s){int r=usdr_dms_destroy(s);if(!res)res=r;}
+    if(d){int r=usdr_dmd_close(d);if(!res)res=r;}
+    free(scratch);
+    if(res)fprintf(stderr,"Probe failed: %s (%d)\n",strerror(-res),res);
+    return res?1:0;
+}
