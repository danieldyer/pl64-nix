index 0000000..a32f5e5
--- /dev/null
+++ b/src/utests/rfic/pcie_dma_test.c
@@ -0,0 +1,62 @@
+// SPDX-License-Identifier: MIT
+// Compile the real Linux transport against a modeled ioctl boundary.
+#include <assert.h>
+#include <stdarg.h>
+#include <sys/ioctl.h>
+static int model_ioctl(int fd, unsigned long request, ...);
+#define ioctl model_ioctl
+#include "../../lib/lowlevel/pcie_uram/pcie_uram_main.c"
+#undef ioctl
+
+static unsigned ioctl_calls, wait_calls, release_calls, result_count=2;
+static int injected_errno, bad_oob;
+static int model_ioctl(int fd, unsigned long request, ...)
+{
+    (void)fd; ++ioctl_calls;
+    if (injected_errno) {errno=injected_errno;injected_errno=0;return -1;}
+    va_list args; va_start(args,request);
+    if (request==PCIE_DRIVER_DMA_WAIT_OOB) {
+        struct pcie_driver_woa_oob *o=va_arg(args,void*);++wait_calls;
+        uint64_t *data=o->oobdata;
+        for (unsigned i=0;i<result_count;++i){data[2*i]=100+i;data[2*i+1]=200+i;}
+        o->ooblength=16*result_count-(bad_oob ? 1 : 0);
+        va_end(args);return result_count;
+    }
+    va_end(args);
+    if (request==PCIE_DRIVER_DMA_RELEASE) {++release_calls;return 0;}
+    assert(0);return -1;
+}
+int main(void)
+{
+    struct pcie_uram_dev d={0};
+    d.ll.ops=&s_pcie_uram_ops;
+    uint32_t regs[1024]={0},samples[2][16];void *areas[]={samples[0],samples[1]};
+    d.mmaped_io=regs;
+    d.scache[0].mmaped_area=areas;d.scache[0].cfg_totbuf=2;d.scache[0].cfg_bufsize=sizeof(samples[0]);
+    void *p=(void*)1,*q=NULL;uint64_t oob[2]={0};unsigned size=16;
+    assert(pcie_uram_recv_dma_wait(&d.ll,0,DBMAX_SRX+DBMAX_STX,&p,oob,&size,1)==-EINVAL);
+    assert(pcie_uram_recv_dma_release(&d.ll,0,DBMAX_SRX+DBMAX_STX,p)==-EINVAL);
+    assert(pcie_uram_recv_dma_wait(&d.ll,0,0,NULL,oob,&size,1)==-EINVAL);
+    size=8;assert(pcie_uram_recv_dma_wait(&d.ll,0,0,&p,oob,&size,1)==-EINVAL);
+    assert(ioctl_calls==0);size=16;
+    injected_errno=ETIMEDOUT;
+    assert(pcie_uram_recv_dma_wait(&d.ll,0,0,&p,oob,&size,1)==-ETIMEDOUT && p==NULL);
+    assert(!d.scache[0].rx_outstanding && !d.scache[0].bufavail);size=16;
+    assert(pcie_uram_recv_dma_wait(&d.ll,0,0,&p,oob,&size,1)==1);
+    assert(p==areas[0] && oob[0]==100 && oob[1]==200 && size==16);
+    size=16;assert(pcie_uram_recv_dma_wait(&d.ll,0,0,&q,oob,&size,1)==0);
+    assert(q==areas[1] && oob[0]==101 && wait_calls==1);
+    void *extra=(void*)1;size=16;
+    assert(pcie_uram_recv_dma_wait(&d.ll,0,0,&extra,oob,&size,1)==-EBUSY && extra==NULL);
+    assert(pcie_uram_recv_dma_release(&d.ll,0,0,q)==-EINVAL && release_calls==0);
+    injected_errno=EAGAIN;
+    assert(pcie_uram_recv_dma_release(&d.ll,0,0,p)==-EAGAIN && d.scache[0].rx_outstanding==2);
+    assert(pcie_uram_recv_dma_release(&d.ll,0,0,p)==0);
+    assert(pcie_uram_recv_dma_release(&d.ll,0,0,p)==-EINVAL);
+    assert(pcie_uram_recv_dma_release(&d.ll,0,0,q)==0 && release_calls==2);
+    bad_oob=1;size=16;
+    assert(pcie_uram_recv_dma_wait(&d.ll,0,0,&p,oob,&size,1)==-EIO && !p);
+    assert(!d.scache[0].rx_outstanding && !d.scache[0].bufavail);
+    puts("PASS PCIe transport bounds, cached OOB, timeout, FIFO ownership and failed-release retry");
+    return 0;
+}
diff --git a/src/utests/rfic/stream_borrow_test.c b/src/utests/rfic/stream_borrow_test.c
new file mode 100644
index 0000000..9c45a3a
--- /dev/null
+++ b/src/utests/rfic/stream_borrow_test.c
@@ -0,0 +1,89 @@
+// SPDX-License-Identifier: MIT
+// Real stream implementation with a DMA transport model; no sample-copy stub
+// is involved in acquire/release. Copy receive uses the same metadata path.
+#include "../../lib/ipblks/streams/stream_sfetrx4_dma32.c"
+
+static uint32_t samples[16];
+static unsigned waits, releases, copies, lost, overflow;
+static int wait_error, release_error;
+static int bus_op(lldev_t d, subdev_t s, unsigned op, lsopaddr_t addr,
+                  size_t nin, void *in, size_t nout, const void *out)
+{
+    (void)d; (void)s; (void)nout; (void)out;
+    assert(op == USDR_LSOP_HWREG);
+    if (nin) *(uint32_t*)in = addr == 20 ? overflow : 0;
+    return 0;
+}
+static int wait_dma(lldev_t d, subdev_t s, stream_t ch, void **out,
+                    void *oob, unsigned *size, unsigned timeout)
+{
+    (void)d; (void)s; (void)ch; (void)timeout;
+    ++waits;
+    if (wait_error) return wait_error;
+    assert(*size >= 16);
+    *(uint64_t*)oob = (0x80000000ull << 32) | lost;
+    ((uint64_t*)oob)[1] = 0;
+    *size = 16; *out = samples;
+    return 0;
+}
+static int release_dma(lldev_t d, subdev_t s, stream_t ch, void *p)
+{
+    (void)d; (void)s; (void)ch;
+    assert(p == samples);
+    if (release_error) { release_error = 0; return -EIO; }
+    ++releases;
+    return 0;
+}
+static int get_name(lldev_t d, int op, const char **out)
+{ (void)d; (void)op; *out = "DMA model"; return 0; }
+static void copy_samples(const void *restrict *restrict in, unsigned inbytes, void *restrict *restrict out, unsigned outbytes)
+{ assert(inbytes == 64 && outbytes == 64); ++copies; memcpy(*out,*in,64); }
+
+int main(void)
+{
+    lowlevel_ops_t ops = {.ls_op=bus_op, .recv_dma_wait=wait_dma,
+                         .recv_dma_release=release_dma, .generic_get=get_name};
+    lowlevel_dev_t ll = {.ops=&ops};
+    device_t dev = {.dev=&ll};
+    stream_sfetrx_dma32_t stream = {0};
+    stream.base.dev=&dev; stream.base.ops=&s_sfetr4_dma32_ops;
+    stream.type=USDR_ZCPY_RX; stream.native_ci16=true; stream.channels=1;
+    stream.pkt_bytes=stream.host_bytes=64; stream.pkt_symbs=16;
+    stream.burst_mask=0x80000000; stream.tf_data=copy_samples;
+    stream.overflow_reg=20;
+    pusdr_dms_t handle=(pusdr_dms_t)&stream;
+    usdr_dms_rx_block_t block, stale, invalid;
+    for (unsigned i=0;i<16;++i) samples[i]=i+0x12340000;
+    assert(usdr_dms_acquire(handle,10,&block)==0);
+    assert(block.data==samples && block.bytes==64 && block.samples==16 && copies==0);
+    assert(block.timestamp==0 && block.lost_samples==0 && block.flags==0);
+    stale=block;
+    assert(usdr_dms_acquire(handle,10,&invalid)==-EBUSY && waits==1);
+    assert(_sfetrx4_op(&stream.base,USDR_DMS_STOP,0)==-EBUSY);
+    assert(_sfetrx4_destroy(&stream.base)==-EBUSY);
+    invalid=block; ++invalid.token;
+    assert(usdr_dms_release(handle,&invalid)==-EINVAL && releases==0);
+    release_error=1;
+    assert(usdr_dms_release(handle,&block)==-EIO && stream.leased==samples);
+    assert(usdr_dms_release(handle,&block)==0 && releases==1);
+    assert(usdr_dms_release(handle,&block)==-EINVAL);
+    lost=2;
+    assert(usdr_dms_acquire(handle,10,&block)==0);
+    assert(block.timestamp==48 && block.lost_samples==32 && block.flags==USDR_DMS_BLOCK_DISCONTINUITY);
+    assert(usdr_dms_release(handle,&stale)==-EINVAL);
+    assert(usdr_dms_release(handle,&block)==0);
+    uint32_t copied[16]; void *dest=copied; usdr_dms_recv_nfo_t nfo={0};
+    lost=0;
+    assert(usdr_dms_recv(handle,&dest,10,&nfo)==0 && copies==1);
+    assert(memcmp(copied,samples,64)==0 && nfo.fsymtime==64 && nfo.totlost==32);
+    wait_error=-ETIMEDOUT;
+    assert(usdr_dms_acquire(handle,10,&block)==-ETIMEDOUT && !block.data);
+    wait_error=0; stream.native_ci16=false;
+    unsigned previous=waits;
+    assert(usdr_dms_acquire(handle,10,&block)==-EOPNOTSUPP && waits==previous);
+    stream.native_ci16=true; overflow=1;
+    assert(usdr_dms_acquire(handle,10,&block)==-EOVERFLOW && !block.data && !stream.leased);
+    assert(usdr_dms_acquire(handle,10,&block)==-EOVERFLOW);
+    puts("PASS: native DMA leases, copy compatibility, metadata, timeout, stale release and overflow");
+    return 0;
+}
diff --git a/src/utests/rfic/usdr_ctrl_test.c b/src/utests/rfic/usdr_ctrl_test.c
new file mode 100644
index 0000000..1952c0b
--- /dev/null
+++ b/src/utests/rfic/usdr_ctrl_test.c
@@ -0,0 +1,201 @@
+// SPDX-License-Identifier: MIT
+// Exercise real driver/clock/RFIC code through a modeled SPI/I2C/control bus.
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "../../lib/device/m2_lm6_1/usdr_ctrl.h"
+
+static uint8_t regs[128];
+static unsigned phy_writes, calls, fail_at;
+static unsigned measurement_generation, read_address, measure_failure;
+static bool init_model, external_clock, clock_failure;
+static uint8_t gpo[128];
+static int dc_decode(unsigned x) { return (x & 64) ? -(int)(x & 63) : (int)(x & 63); }
+static int bus_op(lldev_t dev, subdev_t sub, unsigned op, lsopaddr_t addr,
+                  size_t nin, void* in, size_t nout, const void* out)
+{
+    (void)dev; (void)sub;
+    if (++calls == fail_at) return -EIO;
+    if (op == USDR_LSOP_SPI) {
+        assert(nout == 4);
+        unsigned w = *(const uint32_t*)out, r = (w >> 8) & 127;
+        if (nin) {
+            unsigned v = regs[r];
+            if (r == 0 || r == 0x30 || r == 0x50 || r == 0x60) v = 40;
+            // A powered-down TX filter retains the calibration seed.
+            if (r == 0x30 && !(regs[5] & 8)) v = regs[0x32];
+            if (r == 1 || r == 0x31 || r == 0x51 || r == 0x61) v = 0x20;
+            if (r == 0x1a || r == 0x2a) {
+                unsigned c = regs[r - 1] & 63;
+                v = c < 20 ? 0x80 : c > 40 ? 0x40 : 0;
+            }
+            *(uint32_t*)in = v;
+        } else {
+            if ((r == 0x53 || r == 0x63) && (w & 32))
+                assert(!(regs[0x71] & 127) && !(regs[0x72] & 127));
+            regs[r] = w;
+        }
+    } else if (op == USDR_LSOP_I2C_DEV) {
+        if (nin) { memset(in, 0, nin); *(uint8_t*)in = 2; }
+        if (init_model && nin) {
+            unsigned r = *(const uint8_t*)out;
+            if (addr == 0x4e && r == 0x0b) *(uint16_t*)in = 0x1114;
+            if (addr == 0x60) *(uint8_t*)in = r == 0 ? 1 : 0xe0;
+            if (addr == 0x75) *(uint8_t*)in = 4;
+            if (addr == 0x6a && r == 7) {
+                if (clock_failure) return -EIO;
+                // The real rev3 clock generator reports no input until OE is set.
+                *(uint8_t*)in = gpo[IGPO_ENABLE_OSC] || external_clock ? 2 : 0x89;
+            }
+        }
+    } else if (op == USDR_LSOP_HWREG) {
+        if (nout && (addr == 56 || addr == 57)) ++phy_writes;
+        if (nin) memset(in, 0, nin);
+        if (init_model && nin && addr == 19) *(uint32_t*)in = 0x802f0300;
+        if (init_model && nout && addr == 0) {
+            unsigned w = *(const uint32_t*)out;
+            gpo[(w >> 24) & 127] = w;
+        }
+        if (addr == 56) {
+            if (nout) {
+                unsigned w = *(const uint32_t*)out;
+                if (w >> 31) read_address = (w >> 16) & 255;
+                else if (w == 0x06000000) ++measurement_generation;
+            }
+            if (nin) {
+                if (measure_failure) { measure_failure = 0; return -EIO; }
+                int32_t v = 0;
+                if (read_address == 0) v = measurement_generation;
+                if (read_address == 4) v = (dc_decode(regs[0x71]) + 17) * 64 * 65536;
+                if (read_address == 5) v = (dc_decode(regs[0x72]) - 29) * 64 * 65536;
+                *(int32_t*)in = v;
+            }
+        }
+    } else return -EOPNOTSUPP;
+    return 0;
+}
+static int get_name(lldev_t dev, int op, const char** out)
+{
+    (void)dev; (void)op; *out = "test"; return 0;
+}
+static lowlevel_ops_t ops = {.ls_op = bus_op, .generic_get = get_name};
+static lowlevel_dev_t dev = {.ops = &ops};
+
+int main(void)
+{
+    usdr_dev_t d;
+    init_model = true;
+    for (int source = -1; source <= 1; ++source) {
+        memset(gpo, 0, sizeof(gpo));
+        external_clock = source == 1;
+        assert(usdr_ctor(&dev, 0, &d) == 0);
+        assert(usdr_init(&d, source, 26000000) == 0);
+        assert(gpo[IGPO_ENABLE_OSC] == !external_clock);
+        assert(gpo[IGPO_LMS_RST] == 1);
+        assert(usdr_dtor(&d) == 0);
+    }
+    external_clock = false;
+    clock_failure = true;
+    assert(usdr_ctor(&dev, 0, &d) == 0);
+    assert(usdr_init(&d, -1, 26000000) == -EIO);
+    assert(!gpo[IGPO_LMS_RST] && !gpo[IGPO_BOOSTER] && !gpo[IGPO_LED]);
+    clock_failure = init_model = false;
+    memset(regs, 0, sizeof(regs));
+    assert(usdr_ctor(&dev, 0, &d) == 0);
+    d.fref = d.lms.fref = 26000000;
+    d.lms.dev = &dev; d.hw_board_rev = USDR_REV_3; d.hw_board_hasmixer = true;
+    d.si_vco_div = 8; d.rxbb_decim = d.txbb_intr = 1;
+    d.rx_pwren = true; d.mexir_en = true; d.rx_cfg_path = 0;
+    d.rx_rfic_lna = RXPATH_LNA3; d.rx_lo = 202000000;
+    d.cfg_auto_rx[0] = (freq_auto_band_map_t){.stop_freq=230000000,.band=RXPATH_LNA3,.sw=3,.name0="LNAL",.name1="EXT"};
+    d.cfg_auto_rx[1] = (freq_auto_band_map_t){.stop_freq=2800000000u,.band=RXPATH_LNA1,.sw=0,.name0="LNAW",.name1="W"};
+    d.cfg_auto_rx[2] = (freq_auto_band_map_t){.stop_freq=4000000000u,.band=RXPATH_LNA2,.sw=1,.name0="LNAH",.name1="H"};
+    assert(usdr_set_samplerate_ex(&d,64000000,64000000,0,0,0) == 0);
+    assert(d.adc_clk == 64000000 && d.rawsamplerate == 128000000);
+    assert(d.mixer_lo == 304000000 && d.rfic_rx_lo == 506000000);
+    assert(phy_writes == 0);
+    assert(usdr_set_lob_freq(&d,256000000) == 0);
+    assert(d.si_vco_div == 10 && d.adc_clk == 64000000 && d.mixer_lo == 243200000);
+    assert(d.rfic_rx_lo == 445200000);
+
+    usdr_dev_t before = d;
+    fail_at = calls + 1;
+    assert(usdr_set_lob_freq(&d,304000000) == -EIO);
+    assert(memcmp(&before,&d,sizeof(d)) == 0);
+    fail_at = 0;
+    assert(usdr_set_samplerate_ex(&d,128000000,128000000,0,0,0) == -EINVAL);
+    assert(usdr_rfic_fe_set_rxlna(&d,"typo",false) == -EINVAL);
+    d.rx_lo = 300000000;
+    assert(usdr_rfic_fe_set_rxlna(&d,"W",false) == 0);
+    assert(!d.mexir_en && d.rfic_rx_lo == 300000000);
+    assert(usdr_rfic_fe_set_rxlna(&d,"EXT",false) == 0);
+    assert(d.mexir_en && d.rfic_rx_lo == 543200000);
+    int actual_gain;
+    regs[0x64] = 1; // Independent VGA2A/B gain mode.
+    assert(usdr_rfic_set_gain(&d,GAIN_RX_AUTO,0,NULL) == 0);
+    assert((regs[0x75] >> 6) == 2); // No unsupported LNA3 bypass.
+    assert(usdr_rfic_get_rx_gain(&d,&actual_gain) == 0 && actual_gain == 0);
+    assert(usdr_rfic_set_gain(&d,GAIN_RX_AUTO,50,NULL) == 0);
+    assert((regs[0x75] >> 6) == 3);
+    assert(usdr_rfic_get_rx_gain(&d,&actual_gain) == 0 && actual_gain == 50);
+    before = d; fail_at = calls + 2;
+    assert(usdr_rfic_set_gain(&d,GAIN_RX_AUTO,10,NULL) == -EIO);
+    assert(memcmp(&before,&d,sizeof(d)) == 0); fail_at = 0;
+    assert(usdr_rx_iqimb_set(&d,32768,0) == -ERANGE);
+    assert(usdr_rx_iqimb_set(&d,0,IMB_PHASE_MAX+1) == -ERANGE);
+    fail_at = calls + 2;
+    assert(usdr_rx_iqimb_set(&d,500,500) == -EIO);
+    assert(memcmp(&before,&d,sizeof(d)) == 0); fail_at = 0;
+    assert(usdr_tx_iqimb_set(&d,0,0) == -EOPNOTSUPP);
+    assert(usdr_set_extref(&d,true,40000000) == 0);
+    assert(d.lms.fref == 40000000 && d.adc_clk == 64000000);
+    unsigned bw;
+    assert(usdr_rfic_bb_set_badwidth(&d,false,7000000,&bw) == 0 && bw == 7000000);
+    assert(usdr_rfic_bb_set_badwidth(&d,false,0,&bw) == 0 && bw == 0);
+    assert(usdr_set_rxdccorr(&d,true) == -EOPNOTSUPP);
+    assert(usdr_set_rxdccorr(&d,false) == 0);
+    regs[0x71] = 0x80; regs[0x72] = 0x80; regs[0x7c] = 0x1b;
+    d.lms.rfe_in1sel_dci = 0x80;
+    assert(!(regs[5] & 8));
+    assert(usdr_calib_dc(&d,true) == 0);
+    assert(usdr_calib_dc(&d,true) == 0); // Repeat with nonzero front-end codes.
+    assert(!(regs[5] & 8));
+    int result[8];
+    assert(usdr_calibrate(&d,0,USDR_CAL_RXLO,result) == 0);
+    assert(result[0] == -17 && result[1] == 29);
+    assert(dc_decode(regs[0x71]) == -17 && dc_decode(regs[0x72]) == 29);
+    assert((regs[0x71] & 0x80) && (regs[0x72] & 0x80) && regs[0x7c] == 0x1b);
+    assert(d.rx_corr.dc_i == -17 && d.rx_corr.dc_q == 29);
+    uint64_t mean = ~0ull;
+    assert(usdr_rxdccorr(&d,&mean) == 0 && mean == 0);
+    uint8_t old_regs[128]; memcpy(old_regs,regs,sizeof(regs));
+    measure_failure = 1;
+    assert(usdr_calibrate(&d,0,USDR_CAL_RXLO,result) == -EIO);
+    assert(regs[0x71] == old_regs[0x71] && regs[0x72] == old_regs[0x72] && regs[0x7c] == old_regs[0x7c]);
+    d.tx_run = true;
+    assert(usdr_calibrate(&d,0,USDR_CAL_RXLO,result) == -EBUSY);
+    d.tx_run = false;
+    assert(usdr_calibrate(&d,0,USDR_CAL_TXIQIMB,result) == -EOPNOTSUPP);
+    d.rx_run = true;
+    fail_at = calls + 1;
+    assert(usdr_rfic_streaming_down(&d,RFIC_LMS6_RX) == -EIO);
+    assert(d.rx_run && d.rx_pwren);
+    fail_at = 0;
+    assert(usdr_rfic_streaming_down(&d,RFIC_LMS6_RX) == 0);
+    assert(!d.rx_run && !d.rx_pwren);
+    fail_at = calls + 1;
+    assert(usdr_rfic_streaming_up(&d,RFIC_LMS6_RX) == -EIO);
+    assert(!d.rx_run && !d.rx_pwren);
+    fail_at = 0;
+    assert(usdr_rfic_streaming_up(&d,RFIC_LMS6_RX) == 0);
+    assert(d.rx_run && d.rx_pwren);
+    assert(usdr_rfic_streaming_down(&d,RFIC_LMS6_RX) == 0);
+    fail_at = calls + 3; // Front end enabled, then the VGA2 access fails.
+    assert(usdr_rfic_streaming_up(&d,RFIC_LMS6_RX) == -EIO);
+    assert(!d.rx_run && !d.rx_pwren && (regs[5] & 4));
+    fail_at = 0;
+    assert(usdr_rfic_streaming_down(&d,RFIC_LMS6_RX) == 0);
+    assert(!(regs[5] & 4));
+    puts("PASS: auxiliary translation, LO rounding, sample-rate preservation, errors and reference switching");
+    return 0;
+}
