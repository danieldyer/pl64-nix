diff --git a/src/utests/rfic/lms6002d_test.c b/src/utests/rfic/lms6002d_test.c
new file mode 100644
index 0000000..d608c63
--- /dev/null
+++ b/src/utests/rfic/lms6002d_test.c
@@ -0,0 +1,180 @@
+// SPDX-License-Identifier: MIT
+// Register-model tests of the actual driver, including its internal cal engine.
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "../../lib/hw/lms6002d/lms6002d.c"
+
+static uint8_t regfile[128];
+static unsigned calls, fail_call, loads[128], starts[128], result_reads;
+static int fail_read_addr, busy, result1, result2, pll_bad;
+static unsigned gain_at_start[5], mode_at_start[5];
+
+static int mock_spi(lldev_t dev, subdev_t sub, unsigned op, lsopaddr_t bus,
+                    size_t nin, void* in, size_t nout, const void* out)
+{
+    (void)dev; (void)sub; (void)bus;
+    assert(op == USDR_LSOP_SPI && nout == 4);
+    unsigned word = *(const uint32_t*)out;
+    unsigned addr = (word >> 8) & 127;
+    ++calls;
+    if (calls == fail_call)
+        return -EIO;
+    if (nin) {
+        if ((int)addr == fail_read_addr) {
+            fail_read_addr = -1;
+            return -EIO;
+        }
+        unsigned value = regfile[addr];
+        if (addr == 0 || addr == 0x30 || addr == 0x50 || addr == 0x60)
+            value = result_reads++ ? result2 : result1;
+        if (addr == 1 || addr == 0x31 || addr == 0x51 || addr == 0x61)
+            value = 0x20 | (busy ? 2 : 0); // RC=1, DC engine done unless forced busy
+        if (addr == 0x1a || addr == 0x2a) {
+            unsigned cap = regfile[addr - 1] & 63;
+            value = pll_bad ? 0x40 : cap < 20 ? 0x80 : cap > 40 ? 0x40 : 0;
+        }
+        *(uint32_t*)in = value;
+    } else {
+        assert(word & 0x8000);
+        // Calibration result registers are read-only.
+        assert(addr != 0 && addr != 0x30 && addr != 0x50 && addr != 0x60);
+        regfile[addr] = word;
+        if (addr == 3 || addr == 0x33 || addr == 0x53 || addr == 0x63) {
+            if (word & 16)
+                ++loads[addr];
+            if (word & 32) {
+                ++starts[addr];
+                assert(loads[addr] == starts[addr]);
+                if (addr == 3) {
+                    assert((regfile[9] & 0x20) && !(regfile[0x0b] & 2));
+                } else if (addr == 0x33 || addr == 0x53) {
+                    assert(!(regfile[(addr & 0xf0) + 15] & 128));
+                    assert(regfile[9] & (addr == 0x33 ? 2 : 8));
+                } else {
+                    assert(!(regfile[0x6e] & 0xc0) && (regfile[9] & 0x10));
+                    unsigned channel = word & 7;
+                    assert(channel < 5);
+                    gain_at_start[channel] = regfile[0x68];
+                    mode_at_start[channel] = regfile[0x64];
+                }
+            }
+        }
+    }
+    return 0;
+}
+
+static lowlevel_ops_t ops = {.ls_op = mock_spi};
+static struct lowlevel_dev device = {.ops = &ops};
+lowlevel_ops_t* lowlevel_get_ops(lldev_t dev) { return dev->ops; }
+
+static lms6002d_state_t state;
+static void reset(void)
+{
+    memset(&state, 0, sizeof(state));
+    memset(regfile, 0, sizeof(regfile));
+    memset(loads, 0, sizeof(loads));
+    memset(starts, 0, sizeof(starts));
+    calls = fail_call = result_reads = 0;
+    fail_read_addr = -1; busy = pll_bad = 0; result1 = result2 = 40;
+    state.dev = &device; state.fref = 40000000;
+    regfile[9] = 5; regfile[0x0b] = 0x0a;
+    regfile[0x3f] = regfile[0x5f] = 0xd5;
+    regfile[0x64] = 0x36; regfile[0x65] = 4; regfile[0x68] = 0x23;
+    regfile[0x6e] = 0xc0; regfile[0x71] = regfile[0x72] = 0x80;
+    regfile[0x7c] = 0x1b;
+}
+
+int main(void)
+{
+    uint8_t value = 99;
+    reset(); regfile[0x5f] &= ~128; regfile[9] |= 8;
+    assert(lms6002d_calibration_loop(&state, 0x50, 0, &value) == 0 && value == 40);
+    assert(regfile[0x52] == 31 && loads[0x53] == 1);
+    reset(); regfile[0x5f] &= ~128; regfile[9] |= 8;
+    result1 = 31; result2 = 0; value = 99;
+    assert(lms6002d_calibration_loop(&state, 0x50, 0, &value) == -EIO && value == 99);
+    assert(regfile[0x52] == 0 && loads[0x53] == 2);
+    reset(); regfile[0x5f] &= ~128; regfile[9] |= 8;
+    result1 = result2 = 31;
+    assert(lms6002d_calibration_loop(&state, 0x50, 0, &value) == 0 && value == 31);
+    reset(); regfile[0x5f] &= ~128; regfile[9] |= 8; busy = 1;
+    assert(lms6002d_calibration_loop(&state, 0x50, 0, &value) == -ETIMEDOUT);
+
+    reset(); fail_read_addr = 0;
+    assert(lms6002d_cal_lpf(&state) == -EIO);
+    assert(regfile[9] == 5 && regfile[0x0b] == 0x0a);
+    reset(); regfile[0x35] = regfile[0x55] = 0xc0;
+    assert(lms6002d_cal_lpf(&state) == 0);
+    assert(regfile[0x35] == 0xe8 && regfile[0x55] == 0xe8);
+    assert(regfile[9] == 5 && regfile[0x0b] == 0x0a);
+    for (unsigned tx = 0; tx < 2; ++tx) {
+        reset();
+        assert(lms6002d_cal_txrxlpfdc(&state, tx) == 0);
+        assert(regfile[9] == 5 && regfile[0x3f] == 0xd5 && regfile[0x5f] == 0xd5);
+        reset(); fail_read_addr = tx ? 0x30 : 0x50;
+        assert(lms6002d_cal_txrxlpfdc(&state, tx) == -EIO);
+        assert(regfile[9] == 5 && regfile[0x3f] == 0xd5 && regfile[0x5f] == 0xd5);
+    }
+    reset();
+    assert(lms6002d_cal_vga2(&state) == 0);
+    assert(!(mode_at_start[0] & 1));
+    for (unsigned ch = 1; ch < 5; ++ch) {
+        assert(mode_at_start[ch] == 0x37);
+        assert(gain_at_start[ch] == (ch < 3 ? 0x06 : 0x60));
+    }
+    assert(regfile[0x64] == 0x36 && regfile[0x65] == 4 && regfile[0x68] == 0x23);
+    assert(regfile[0x6e] == 0xc0 && regfile[9] == 5);
+    reset(); fail_read_addr = 0x60;
+    assert(lms6002d_cal_vga2(&state) == -EIO);
+    assert(regfile[0x64] == 0x36 && regfile[0x68] == 0x23 && regfile[0x6e] == 0xc0);
+
+    reset();
+    assert(lms6002d_rxvga2_enable(&state, true) == 0 && regfile[0x64] == 0x37);
+    assert(lms6002d_set_rxfedc(&state, -1, -63) == 0);
+    assert(regfile[0x71] == 0xc1 && regfile[0x72] == 0xff);
+    assert(lms6002d_set_rx_extterm(&state, true) == 0);
+    assert(regfile[0x71] == 0x41 && regfile[0x7c] == 0x1f);
+    assert(lms6002d_set_rx_extterm(&state, false) == 0);
+    assert(regfile[0x71] == 0xc1 && regfile[0x7c] == 0x1b);
+    regfile[0x73] = 0x80;
+    assert(lms6002d_set_rxfe_ip2corr(&state, -63, -1) == 0);
+    assert(regfile[0x73] == 0xff && regfile[0x74] == 0x41);
+    unsigned before = calls;
+    assert(lms6002d_set_rxfedc(&state, -64, 0) == -ERANGE && calls == before);
+
+    reset(); regfile[6] = 0x0b; regfile[7] = 3; fail_read_addr = 1;
+    assert(lms6002d_cal_lpf_bandwidth(&state, 6, false) == -EIO);
+    assert(!(state.rclpfcal[6] & 0x80));
+    assert(regfile[6] == 0x0b && regfile[7] == 3 && regfile[9] == 5);
+    reset();
+    assert(lms6002d_cal_lpf_bandwidth(&state, 6, false) == 0 && state.rclpfcal[6] == 0x81);
+    regfile[0x55] = 0xe8; regfile[0x56] = 0x8b;
+    assert(lms6002d_set_bandwidth(&state, false, 7000000) == 0);
+    assert(regfile[0x55] == 0xa8 && regfile[0x56] == 0x9b);
+    assert(state.rx_bandwidth == 7000000);
+    assert(lms6002d_set_bandwidth(&state, false, 64000000) == 0);
+    assert(regfile[0x55] == 0xe8 && state.rx_bandwidth == 0);
+
+    reset(); pll_bad = 1;
+    assert(lms6002d_tune_pll(&state, false, 506000000) == -ENOLCK);
+    lms6002_pll_stat_t cached = {.vco_cap_min=20, .vco_cap_max=40, .vco_num=4, .vco_div=2};
+    assert(lms6002d_tune_pll_stat(&state, false, 506000000, false, &cached) == -ENOLCK);
+    assert(regfile[0x2b] & 8);
+    pll_bad = 0;
+    assert(lms6002d_tune_pll_stat(&state, false, 506000000, false, &cached) == 0);
+    assert((regfile[0x29] & 63) == 30 && (regfile[0x2b] & 8));
+    assert(lms6002d_tune_pll(&state, false, 506000000) == 0);
+    assert((regfile[0x29] & 63) >= 20 && (regfile[0x29] & 63) <= 40);
+    state.fref = 0;
+    assert(lms6002d_tune_pll(&state, false, 506000000) == -ERANGE);
+
+    // Every one-shot SPI failure must be observable, including cleanup writes.
+    reset(); assert(lms6002d_cal_vga2(&state) == 0); unsigned total = calls;
+    for (unsigned n = 1; n <= total; ++n) {
+        reset(); fail_call = n;
+        assert(lms6002d_cal_vga2(&state) == -EIO);
+    }
+    puts("PASS: DC load/retry/timeout, field preservation, LPF/VGA2 sequencing, PLL and SPI failures");
+    return 0;
+}
