+static int _sfetrx4_release_buffer(stream_sfetrx_dma32_t *stream)
+{
+    lldev_t dev = stream->base.dev->dev;
+    int res = lowlevel_get_ops(dev)->recv_dma_release(dev, 0, stream->ll_streamo, stream->leased);
+    if (!res) { stream->leased = NULL; stream->lease_external = false; }
+    return res;
+}
+
+static int _sfetrx4_acquire(stream_handle_t *str, unsigned timeout, usdr_dms_rx_block_t *block)
+{
+    stream_sfetrx_dma32_t *stream = (stream_sfetrx_dma32_t*)str;
+    if (!stream->native_ci16 || stream->type != USDR_ZCPY_RX) return -EOPNOTSUPP;
+    usdr_dms_recv_nfo_t nfo = {0};
+    int res = _sfetrx4_acquire_buffer(str, timeout, &nfo);
+    if (res) return res;
+    stream->lease_external = true;
+    *block = (usdr_dms_rx_block_t){
+        .data = stream->leased, .bytes = stream->pkt_bytes, .samples = stream->pkt_symbs,
+        .format = USDR_DMS_NATIVE_CI16_LE, .timestamp = nfo.fsymtime,
+        .lost_samples = stream->block_lost, .token = stream->lease_token,
+        .flags = stream->block_lost ? USDR_DMS_BLOCK_DISCONTINUITY : 0,
+    };
     return 0;
 }
 
+static int _sfetrx4_release(stream_handle_t *str, const usdr_dms_rx_block_t *block)
+{
+    stream_sfetrx_dma32_t *stream = (stream_sfetrx_dma32_t*)str;
+    if (!stream->leased || block->data != stream->leased || block->token != stream->lease_token)
+        return -EINVAL;
+    return _sfetrx4_release_buffer(stream);
+}
+
+static int _sfetrx4_stream_recv(stream_handle_t *str, char **buffers, unsigned timeout,
+                              usdr_dms_recv_nfo_t *nfo)
+{
+    stream_sfetrx_dma32_t *stream = (stream_sfetrx_dma32_t*)str;
+    if (!buffers) return -EINVAL;
+    int res = _sfetrx4_acquire_buffer(str, timeout, nfo);
+    if (res) return res;
+    const void *input = stream->leased;
+    stream->tf_data(&input, stream->pkt_bytes, (void**)buffers, stream->host_bytes);
+    return _sfetrx4_release_buffer(stream);
+}
