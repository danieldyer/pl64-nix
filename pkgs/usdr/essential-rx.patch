@@ -10,6 +10,20 @@
 #include <string.h>
 #include <assert.h>
 
+int usdr_dms_acquire(pusdr_dms_t stream, unsigned timeout_ms, usdr_dms_rx_block_t *block)
+{
+    if (!stream || !block) return -EINVAL;
+    struct stream_handle *h = (struct stream_handle*)stream;
+    memset(block, 0, sizeof(*block));
+    return h->ops->acquire ? h->ops->acquire(h, timeout_ms, block) : -EOPNOTSUPP;
+}
+
+int usdr_dms_release(pusdr_dms_t stream, const usdr_dms_rx_block_t *block)
+{
+    if (!stream || !block) return -EINVAL;
+    struct stream_handle *h = (struct stream_handle*)stream;
+    return h->ops->release ? h->ops->release(h, block) : -EOPNOTSUPP;
+}
 
 int usdr_dms_destroy(pusdr_dms_t stream)
 {
diff --git a/src/lib/models/dm_stream.h b/src/lib/models/dm_stream.h
index f2076f3..8e6fc00 100644
--- a/src/lib/models/dm_stream.h
+++ b/src/lib/models/dm_stream.h
@@ -97,6 +97,28 @@ struct usdr_dms_recv_nfo {
 };
 typedef struct usdr_dms_recv_nfo usdr_dms_recv_nfo_t;
 
+enum usdr_dms_native_format { USDR_DMS_NATIVE_CI16_LE = 1 };
+enum usdr_dms_block_flags { USDR_DMS_BLOCK_DISCONTINUITY = 1 };
+
+// Read-only native DMA storage, valid until release. One outstanding block per
+// stream. Serialize calls on a stream; release before stop, destroy or device
+// close. Unsupported wire layouts return -EOPNOTSUPP without consuming data.
+// CI16_LE is interleaved signed 16-bit I,Q. No conversion or sample copy occurs.
+struct usdr_dms_rx_block {
+    const void *data;
+    size_t bytes;
+    unsigned samples;
+    unsigned format;
+    dm_time_t timestamp;
+    uint64_t lost_samples; // Samples lost immediately before this block
+    uint64_t token;        // Opaque lease; stale/wrong releases are rejected
+    unsigned flags;
+};
+typedef struct usdr_dms_rx_block usdr_dms_rx_block_t;
+
+int usdr_dms_acquire(pusdr_dms_t stream, unsigned timeout_ms, usdr_dms_rx_block_t *block);
+int usdr_dms_release(pusdr_dms_t stream, const usdr_dms_rx_block_t *block);
+
 struct usdr_dms_send_stat {
     dm_time_t lhwtime;
     dm_time_t opkttime;
