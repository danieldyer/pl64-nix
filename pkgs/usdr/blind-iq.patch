+    next.rx_iqc_mode = 0; // Explicit manual calibration overrides autonomous IQ.
     next.rx_corr.ampl = (int64_t)iq_amp_imb * IMB_AMPL_MAX / INT16_MAX;
     next.rx_corr.pahse = phase_imb;
     int res = usdr_rxupdate_cal(&next);
@@ -2121,5 +2142,11 @@ int usdr_calibrate(usdr_dev_t *d, unsigned channel, unsigned param, int* sarray)
                 usdr_cleanup_error(&res, usdr_lms_write(d, regs[i], saved[i]));
         usdr_cleanup_error(&res, usdr_rxupdate_cal(d));
     } else if (sarray) memcpy(sarray, result, sizeof(result));
+    if (!res && (param & USDR_CAL_RXIQIMB)) d->rx_iqc_mode = 0;
+    if (d->rx_iqc_mode) {
+        unsigned mode = d->rx_iqc_mode == 1 ? 5 : d->rx_iqc_mode;
+        int iqres = usdr_rx_iqc_set(d, mode);
+        if (iqres != -EOPNOTSUPP) usdr_cleanup_error(&res, iqres);
+    }
     return res;
 }
