+static int usdr_iqc_set(pdevice_t ud, pusdr_vfs_obj_t obj, uint64_t value)
+{
+    (void)obj;
+    if (value > 7) return -EINVAL;
+    return usdr_rx_iqc_set(&((struct dev_m2_lm6_1 *)ud)->d, value);
+}
+
+static int usdr_iqc_get(pdevice_t ud, pusdr_vfs_obj_t obj, uint64_t *out)
+{
+    struct usdr_dev *d = &((struct dev_m2_lm6_1 *)ud)->d;
+    const char *key = strrchr(obj->full_path, '/') + 1;
+    unsigned address = !strcmp(key, "generation") ? 2 :
+                       !strcmp(key, "coeff_i") ? 3 : !strcmp(key, "coeff_q") ? 4 :
+                       !strcmp(key, "coeff_qi") ? 5 : !strcmp(key, "dc") ? 6 :
+                       !strcmp(key, "raw_clips") ? 8 : !strcmp(key, "tick") ? 9 :
+                       !strcmp(key, "rejected") ? 11 : !strcmp(key, "raw_power") ? 12 :
+                       !strcmp(key, "raw_peak") ? 14 : 1;
+    uint32_t signature;
+    int res = usdr_rx_iqc_read(d, 0, &signature);
+    if (res) return res;
+    if (signature != 0x49514331) return -EOPNOTSUPP;
+    // Paired values belong to one correction epoch; never return torn offsets.
+    for (unsigned attempt = 0; attempt < 8; ++attempt) {
+        uint32_t before, after, low, high = 0;
+        res = usdr_rx_iqc_read(d, address >= 12 ? 15 : 2, &before);
+        res = res ? res : usdr_rx_iqc_read(d, address, &low);
+        if (address == 6 || address == 9 || address == 12)
+            res = res ? res : usdr_rx_iqc_read(d, address + 1, &high);
+        res = res ? res : usdr_rx_iqc_read(d, address >= 12 ? 15 : 2, &after);
+        if (res) return res;
+        if (before == after) { *out = (uint64_t)high << 32 | low; return 0; }
+    }
+    return -EAGAIN;
+}
