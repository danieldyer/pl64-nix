+int usdr_rx_iqc_read(usdr_dev_t *d, unsigned address, uint32_t *value)
+{
+    if (!value || address > 15) return -EINVAL;
+    int res = lowlevel_reg_wr32(d->base.dev, 0, REG_CFG_PHY_0, MAKE_PHY_RD_REG(7, address << 16));
+    return res ? res : lowlevel_reg_rd32(d->base.dev, 0, REG_CFG_PHY_0, value);
+}
+
+int usdr_rx_iqc_set(usdr_dev_t *d, unsigned mode)
+{
+    if ((mode & ~7u) || ((mode & 2) && !(mode & 1))) return -EINVAL;
+    uint32_t signature;
+    int res = usdr_rx_iqc_read(d, 0, &signature);
+    if (res) return res;
+    if (signature != 0x49514331) return -EOPNOTSUPP;
+    res = lowlevel_reg_wr32(d->base.dev, 0, REG_CFG_PHY_0, MAKE_PHY_WR_SUB_REG(7, 1, mode));
+    if (!res) d->rx_iqc_mode = mode & 3;
+    return res;
+}
