option(PL64_MCAP_USE_ZLIB_NG "Use the native zlib-ng IEEE CRC backend" OFF)
find_path(MCAP_INCLUDE_DIR mcap/writer.hpp REQUIRED)
add_library(pl64-mcap-crc INTERFACE)
if(PL64_MCAP_USE_ZLIB_NG)
  find_package(PkgConfig REQUIRED)
  pkg_check_modules(PL64_ZLIB_NG REQUIRED IMPORTED_TARGET zlib-ng)
  target_link_libraries(pl64-mcap-crc INTERFACE PkgConfig::PL64_ZLIB_NG)
  target_compile_definitions(pl64-mcap-crc INTERFACE PL64_MCAP_USE_ZLIB_NG)
else()
  find_package(ZLIB REQUIRED)
  target_link_libraries(pl64-mcap-crc INTERFACE ZLIB::ZLIB)
endif()
if(BUILD_TESTING)
  add_executable(mcap-crc-tests ${CMAKE_CURRENT_LIST_DIR}/../tests/mcap_crc.cpp)
  target_include_directories(mcap-crc-tests SYSTEM PRIVATE ${MCAP_INCLUDE_DIR})
  target_link_libraries(mcap-crc-tests PRIVATE pl64-mcap-crc)
  target_compile_features(mcap-crc-tests PRIVATE cxx_std_23)
  add_test(NAME mcap-crc COMMAND mcap-crc-tests)
endif()
